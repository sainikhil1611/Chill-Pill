# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
#
# Both keys are read server-side only (app/api/*), at request time. The app
# builds and starts without them; a route whose key is missing answers with a
# clear JSON error ("<KEY> is not configured on the server") instead of crashing.

# ElevenLabs API key — generates the playlist tracks (POST /api/music) and any
# track the chat agent regenerates. Needed for every production playlist; not
# needed for `npm run dev`, which serves the sample tracks in public/tracks/.
# Requires a plan with Music API access: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini API key — powers the "tweak my playlist" chat agent
# (POST /api/agent), which decides between an ffmpeg edit and a regeneration.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
